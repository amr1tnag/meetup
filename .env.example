# Copy to .env.local and fill in. See README → "Backend setup".

# Public by design: inlined into the browser bundle, guarded by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only. Used by `supabase link` / `db push`, never by the app.
SUPABASE_DB_PASSWORD=
